RCN_AUTH_USER=admin
# WYMAGANE przed startem: serwer NIE wystartuje z wartością domyślną `change-me`.
RCN_AUTH_PASSWORD=change-me
# Opcjonalne konto tylko-do-odczytu (oba pola muszą być ustawione):
# RCN_READONLY_USER=viewer
# RCN_READONLY_PASSWORD=
RCN_DATA_DIR=./data
RCN_MAX_UPLOAD_MB=512
# Interface to bind on host (override to 127.0.0.1 for loopback-only
# or to a private/VPN IP for restricted exposure)
RCN_BIND=127.0.0.1
RCN_PORT=8000
RCN_LOG_LEVEL=info
# Opcjonalna analityka (np. self-hosted Umami) -- snippet renderuje się tylko,
# gdy OBA pola ustawione. Domyślnie wyłączona.
# RCN_ANALYTICS_SCRIPT_URL=https://analytics.example.com/script.js
# RCN_ANALYTICS_WEBSITE_ID=
# Link "Kod źródłowy" w UI (AGPL §13). Pusta wartość ukrywa link.
# RCN_SOURCE_URL=https://github.com/emer-MR/rcn-workshop
# Opcjonalny link "Podziel się opinią" (ankieta/formularz). Niewypełnione = brak linku.
# Pokazuje się w nav aplikacji oraz na stronie powitalnej dla niezalogowanych.
# RCN_SURVEY_URL=https://forms.gle/xxxxxxxx
# Opcjonalny link do pobrania instalatora desktop (przycisk na splashu + redirect /pobierz).
# RCN_DOWNLOAD_URL=https://example.com/pobieranie/RCN-Workshop-Setup.exe
# Okno ostrzegawcze "wersja testowa" -- raz na sesję przeglądarki, za logowaniem.
# Włączać na instancjach demonstracyjnych/prezentacyjnych, nie na produkcji.
# RCN_TEST_WARNING=1
# Konto testowe (rola readonly: odczyt, eksport, analiza; bez importu i edycji).
# Do udostępnienia uczestnikom prezentacji. Admin loguje się jak dotąd.
# RCN_READONLY_USER=test
# RCN_READONLY_PASSWORD=test
